# SystemMsg-e.dat of P152 to 166: the sound and the voice are numbers of texts in L2GameDataName.dat, and the row
# ends with four texts.
format  1
file    SystemMsg-*.dat
title   P152 to 166

list uint records {
    uint    id              # the MsgNo of a cut scene
    uint    unknown
    fstring message         # the line
    uint    group
    uint    color           # red, green, blue and alpha bytes
    int     sound           # the number of a text in L2GameDataName.dat
    int     voice           # the number of a text in L2GameDataName.dat
    uint    window
    uint    font
    uint    lifeTime
    uint    background
    uint    animation
    fstring screenMessage
    fstring gfxScreenMessage
    fstring gfxScreenParameter
    fstring type
}

# EtcItemgrp.dat of Chronicle 4 to Interlude: the items that are neither weapons nor armor, and their icons.
# The texts stand in the rows. The tables of Chronicle 4, Chronicle 5 and Interlude read so.
format  1
file    EtcItemgrp.dat
title   Chronicle 4 to Interlude

list uint records {
    uint    tag
    uint    id                  # the item id of the server
    uint    dropType
    uint    dropAnimType
    uint    dropRadius
    uint    dropHeight
    uint    unknown1
    string  dropMesh1
    string  dropMesh2
    string  dropMesh3
    string  dropTexture1
    string  dropTexture2
    string  dropTexture3
    string  icon                # the icon of the inventory, such as icon.etc_adena_i00
    string  icon2
    string  icon3
    string  icon4
    string  icon5
    uint    durability
    uint    weight
    uint    material
    uint    crystallizable
    uint    unknown2
    list uint string meshes
    list uint string textures
    string  dropSound
    string  equipSound
    uint    stackable
    uint    etcItemType
    uint    crystalType
}

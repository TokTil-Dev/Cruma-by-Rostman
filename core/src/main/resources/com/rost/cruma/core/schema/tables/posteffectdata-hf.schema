# PostEffectData.dat of High Five: the post effects a cut scene plays by their number, each with its name.
format  1
file    PostEffectData.dat
title   High Five

list uint records {
    uint    id              # the PostEffectID of a cut scene
    string  name
    uint    type            # 0 a change of luma and chroma, 3 a motion blur
    uint    mode            # 0 from the first values to the second, 1 from none to the second, 2 from the first to none
    float   seconds         # how long a change of colour takes, or 0 for at once
    uint    keepsChroma     # not 0: a change of colour leaves Cb and Cr
    list 3 float first      # a motion blur has its alpha and the milliseconds it takes to come to it here
    list 3 float second
    uint    reserve1
    uint    reserve2
}

# Armorgrp.dat of Chronicle 4 to Interlude: how the client draws each armor piece on each figure, and its icon.
# The texts stand in the rows. The figures are those of Interlude, and the body parts are numbered as
# Interlude numbers them: 15 is armor of one piece, 16 a full costume and 19 a hat. The tables of Chronicle 4,
# Chronicle 5 and Interlude read so.
format  1
file    Armorgrp.dat
title   Chronicle 4 to Interlude
set     bodyParts 1             # the body parts are numbered as Interlude numbers them

# What one figure wears: the body part meshes and their textures, then the additional meshes and their
# textures.
struct Look {
    list uint string meshes
    list uint string textures
    list uint string addMeshes
    list uint string addTextures
}

# Meshes and textures that no figure of Interlude wears.
struct MeshSet {
    list uint string meshes
    list uint string textures
}

list uint records {
    uint    tag
    uint    id                  # the item id of the server
    uint    dropType
    uint    dropAnimType
    uint    dropRadius
    uint    dropHeight
    uint    unknown1
    string  dropMesh1
    string  dropMesh2
    string  dropMesh3
    string  dropTexture1
    string  dropTexture2
    string  dropTexture3
    string  icon                # the icon of the inventory, such as icon.armor_t02_u_i00
    string  icon2
    string  icon3
    string  icon4
    string  icon5
    int     durability
    uint    weight
    uint    material
    uint    crystallizable
    uint    properties
    uint    bodyPart            # where it is worn
    Look    mfighter
    Look    ffighter
    Look    mdarkelf
    Look    fdarkelf
    Look    mdwarf
    Look    fdwarf
    Look    melf
    Look    felf
    Look    mmagic
    Look    fmagic
    Look    morc
    Look    forc
    Look    mshaman
    Look    fshaman
    MeshSet unknownSet
    MeshSet npcSet
    MeshSet aacSet
    string  attackEffect
    list uint string itemSounds
    string  dropSound
    string  equipSound
    uint    unknown2
    uint    unknown3
    uint    armorType
    uint    crystalType
    uint    avoidModify
    uint    pDefense
    uint    mDefense
    uint    mpBonus
}

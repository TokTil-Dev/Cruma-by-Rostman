# PawnAnimData.dat with the texts in the rows in place of numbers of texts in L2GameDataName.dat, as the Classic
# and Arena worlds of 162 have it.
format  1
file    PawnAnimData.dat
title   Classic of 162

list uint records {
    string  class           # the class without its package, such as eyeless
    list uint anims {
        uint    key         # the PawnAnimKey as this table numbers it: it has no ArenaDeath, so the death is 0x3C
                            # as on P152, and the death wait 0x3D and NpcSocialAnimName 0x5B are one lower
        uint    index       # the kind of weapon, 0 for an NPC; for a social its number from 0
        string  anim        # the sequence, such as spatk03
    }
    list compact numbers {
        uint    key
        uint    index
        int     value
    }
    list compact moreNumbers {
        uint    key
        uint    index
        int     value
    }
    list compact floats {
        uint    key
        uint    index
        float   value
    }
}

+
+	extern "C" __attribute__((visibility("default")))
+	uint32_t cruma_bgfx_metal_enqueue_shared_event_fence(
+		void* _waitEvent, uint64_t _waitValue,
+		void* _signalEvent, uint64_t _signalValue)
+	{
+		if (NULL == _waitEvent || 0 == _waitValue
+		||  NULL == _signalEvent || 0 == _signalValue)
+		{
+			return 0;
+		}
+
+		BGFX_MUTEX_SCOPE(s_crumaMetalSharedEventMutex);
+		if (s_crumaMetalPendingFenceCount >= BX_COUNTOF(s_crumaMetalPendingFences))
+		{
+			return 0;
+		}
+
+		MTL::SharedEvent* waitEvent = static_cast<MTL::SharedEvent*>(_waitEvent);
+		MTL::SharedEvent* signalEvent = static_cast<MTL::SharedEvent*>(_signalEvent);
+		waitEvent->retain();
+		signalEvent->retain();
+		s_crumaMetalPendingFences[s_crumaMetalPendingFenceCount++] = {
+			waitEvent, _waitValue, signalEvent, _signalValue, cruma_bgfx_api_frame_number()
+		};
+		return 1;
+	}
+
+	static void crumaMetalEncodeSharedEventWaits(
+		MTL::CommandBuffer* _commandBuffer, CommandQueueMtl& _commandQueue, uint32_t _frameNum)
+	{
+		CrumaMetalSharedEventFence fences[BX_COUNTOF(s_crumaMetalPendingFences)];
+		uint32_t count;
+		{
+			BGFX_MUTEX_SCOPE(s_crumaMetalSharedEventMutex);
+			count = 0;
+			uint32_t remaining = 0;
+			for (uint32_t ii = 0; ii < s_crumaMetalPendingFenceCount; ++ii)
+			{
+				const CrumaMetalSharedEventFence& fence = s_crumaMetalPendingFences[ii];
+				if (int32_t(_frameNum - fence.m_frameNum) >= 0)
+				{
+					fences[count++] = fence;
+				}
+				else
+				{
+					s_crumaMetalPendingFences[remaining++] = fence;
+				}
+			}
+			s_crumaMetalPendingFenceCount = remaining;
+		}
+
+		BX_ASSERT(0 == s_crumaMetalActiveFenceCount,
+			"Previous cruma Metal consumer signals were not encoded");
+		for (uint32_t ii = 0; ii < count; ++ii)
+		{
+			_commandBuffer->encodeWait(fences[ii].m_waitEvent, fences[ii].m_waitValue);
+			_commandQueue.release(fences[ii].m_waitEvent);
+			s_crumaMetalActiveFences[s_crumaMetalActiveFenceCount++] = fences[ii];
+		}
+	}
+
+	static void crumaMetalEncodeSharedEventSignals(
+		MTL::CommandBuffer* _commandBuffer, CommandQueueMtl& _commandQueue)
+	{
+		for (uint32_t ii = 0; ii < s_crumaMetalActiveFenceCount; ++ii)
+		{
+			const CrumaMetalSharedEventFence& fence = s_crumaMetalActiveFences[ii];
+			_commandBuffer->encodeSignalEvent(fence.m_signalEvent, fence.m_signalValue);
+			_commandQueue.release(fence.m_signalEvent);
+		}
+		s_crumaMetalActiveFenceCount = 0;
+	}
+
+	static void crumaMetalReleasePendingSharedEvents()
+	{
+		BGFX_MUTEX_SCOPE(s_crumaMetalSharedEventMutex);
+		for (uint32_t ii = 0; ii < s_crumaMetalPendingFenceCount; ++ii)
+		{
+			s_crumaMetalPendingFences[ii].m_waitEvent->release();
+			s_crumaMetalPendingFences[ii].m_signalEvent->release();
+		}
+		s_crumaMetalPendingFenceCount = 0;
+	}

+	static bx::Mutex s_crumaMetalSharedEventMutex;
+	static CrumaMetalSharedEventFence s_crumaMetalPendingFences[32];
+	static uint32_t s_crumaMetalPendingFenceCount = 0;
+	static CrumaMetalSharedEventFence s_crumaMetalActiveFences[32];

+	static bx::Mutex s_crumaCopyPoolMutex;
+	static CrumaCopyBlock* s_crumaCopyBins[16] = {};
+	static uint32_t s_crumaCopyBinCounts[16] = {};
+	static uint64_t s_crumaCopyBinHits[16] = {};
+	static uint64_t s_crumaCopyBinMisses[16] = {};
+	static uint64_t s_crumaCopyCachedBytes = 0;
+	static uint64_t s_crumaCopyHits = 0;
+	static uint64_t s_crumaCopyMisses = 0;
+	static uint64_t s_crumaCopyInUse = 0;
+
+	extern "C" BGFX_SHARED_LIB_API uint64_t cruma_bgfx_copy_pool_stat(uint32_t _stat)
+	{
+		BGFX_MUTEX_SCOPE(s_crumaCopyPoolMutex);
+		switch (_stat)
+		{
+		case 0: return s_crumaCopyCachedBytes;
+		case 1: return s_crumaCopyHits;
+		case 2: return s_crumaCopyMisses;
+		case 3: return s_crumaCopyInUse;
+		default: return 0;
+		}
+	}
+
+	static void crumaReleaseCopyBlock(void*, void* _userData)
+	{
+		CrumaCopyBlock* block = static_cast<CrumaCopyBlock*>(_userData);
+		{
+			BGFX_MUTEX_SCOPE(s_crumaCopyPoolMutex);
+			BX_ASSERT(s_crumaCopyInUse > 0, "Released an unowned upload block");
+			--s_crumaCopyInUse;
+			if (s_crumaCopyPoolEnabled.load(std::memory_order_relaxed)
+			&&  s_crumaCopyBinCounts[block->bin] < bx::max<uint32_t>(8, 1024 * 1024 / block->capacity))
+			{
+				block->next = s_crumaCopyBins[block->bin];
+				s_crumaCopyBins[block->bin] = block;
+				++s_crumaCopyBinCounts[block->bin];
+				s_crumaCopyCachedBytes += block->capacity;
+				return;
+			}
+		}
+		bx::free(g_allocator, block);
+	}
+
+	static const Memory* crumaAllocCopy(uint32_t _size)
+	{
+		uint32_t bin = 0;
+		uint32_t capacity = 64;
+		while (capacity < _size)
+		{
+			++bin;
+			capacity *= 2;
+		}
+		CrumaCopyBlock* block;
+		{
+			BGFX_MUTEX_SCOPE(s_crumaCopyPoolMutex);
+			block = s_crumaCopyBins[bin];
+			++s_crumaCopyInUse;
+			if (NULL != block)
+			{
+				s_crumaCopyBins[bin] = block->next;
+				--s_crumaCopyBinCounts[bin];
+				s_crumaCopyCachedBytes -= capacity;
+				++s_crumaCopyHits;
+				++s_crumaCopyBinHits[bin];
+			}
+			else
+			{
+				++s_crumaCopyMisses;
+				++s_crumaCopyBinMisses[bin];
+			}
+		}
+		if (NULL == block)
+		{
+			block = static_cast<CrumaCopyBlock*>(bx::alloc(g_allocator, sizeof(CrumaCopyBlock) + capacity) );
+			block->bin = bin;
+			block->capacity = capacity;
+		}
+		block->ref.mem.size = _size;
+		block->ref.mem.data = reinterpret_cast<uint8_t*>(block + 1);
+		block->ref.releaseFn = crumaReleaseCopyBlock;
+		block->ref.userData = block;
+		return &block->ref.mem;
+	}
+
+	static void crumaDrainCopyPool()
+	{
+		s_crumaCopyPoolEnabled.store(false, std::memory_order_relaxed);
+		BGFX_MUTEX_SCOPE(s_crumaCopyPoolMutex);
+		BX_ASSERT(0 == s_crumaCopyInUse, "Upload blocks still owned after renderer shutdown");
+		for (uint32_t bin = 0; bin < BX_COUNTOF(s_crumaCopyBins); ++bin)
+		{
+			CrumaCopyBlock* block = s_crumaCopyBins[bin];
+			while (NULL != block)
+			{
+				CrumaCopyBlock* next = block->next;
+				bx::free(g_allocator, block);
+				block = next;
+			}
+			s_crumaCopyBins[bin] = NULL;
+			s_crumaCopyBinCounts[bin] = 0;
+		}
+		const uint64_t retiredBytes = s_crumaCopyCachedBytes;
+		s_crumaCopyCachedBytes = 0;
+		if (cruma_bgfx_frame_trace_enabled() )
+		{
+			bx::debugPrintf("[cruma-copy-pool] hits=%llu misses=%llu retiredBytes=%llu cachedBytes=%llu inUse=%llu\n"
+				, (unsigned long long)s_crumaCopyHits, (unsigned long long)s_crumaCopyMisses
+				, (unsigned long long)retiredBytes, (unsigned long long)s_crumaCopyCachedBytes
+				, (unsigned long long)s_crumaCopyInUse);
+			for (uint32_t bin = 0; bin < BX_COUNTOF(s_crumaCopyBins); ++bin)
+			{
+				bx::debugPrintf("[cruma-copy-pool-bin] capacity=%u hits=%llu misses=%llu\n", 64u << bin
+					, (unsigned long long)s_crumaCopyBinHits[bin], (unsigned long long)s_crumaCopyBinMisses[bin]);
+			}
+		}
+	}

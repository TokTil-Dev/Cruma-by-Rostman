+			const double ms = 1000.0 / double(bx::getHPFrequency() );
+			if ((traceCopied - traceBegin) * ms > 5.0)
+			{
+				bx::debugPrintf("[cruma-native-copy] bytes=%u allocateMs=%.6f copyMs=%.6f totalMs=%.6f\n"
+					, _size, (traceAllocated - traceBegin) * ms, (traceCopied - traceAllocated) * ms
+					, (traceCopied - traceBegin) * ms);
+			}
+		}
+		return mem;
+	}
 
